{
  "name": "nib-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "dogfood:mcp": "node scripts/dogfood-mcp.mjs",
    "site:build": "cargo run --manifest-path site/Cargo.toml -- --export site/dist",
    "site:worker:build": "cd site && worker-build --release --no-panic-recovery",
    "deploy:site": "wrangler deploy --config site/wrangler.jsonc",
    "test": "vitest run",
    "types": "wrangler types worker/worker-configuration.d.ts",
    "dev": "wrangler dev",
    "deploy": "npm run site:build && npm run deploy:site && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.20.1",
    "jose": "6.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260801.1",
    "typescript": "5.9.2",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  }
}
