{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nib",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
  "assets": {
    "directory": "./site/dist/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },
  "services": [
    { "binding": "SITE", "service": "nib-site" },
    { "binding": "REVIEW", "service": "nib-global" }
  ],
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["login@nibtool.com"] }
  ],
  "routes": [
    { "pattern": "nibtool.com", "custom_domain": true }
  ],
  "triggers": { "crons": ["17 3 * * *", "* * * * *"] },
  "ai": { "binding": "AI" },
  "vars": {
    "ACCEPTANCE_ENABLED": "false",
    "AI_GATEWAY_ID": "default",
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://nibtool.com",
    "CLOUDFLARE_ACCOUNT_ID": "88f9cbf5c4f4e217079bcbf0ca6cb181",
    "TRIAL_NETWORK_IDENTITIES_30D": "3",
    "TRIAL_GLOBAL_DAILY_LIMIT": "50",
    "DEFAULT_PRICE_ID": "price_1U0444GHuCWtbWKOy5hXi8aH",
    "HIGH_PRICE_ID": "price_1U0444GHuCWtbWKOZknqhPjf",
    "USAGE_PRICE_ID": "price_1U044nGHuCWtbWKOAGw6Xy9Y",
    "STRIPE_USAGE_EVENT_NAME": "visualize_usage_cents",
    "STRIPE_PORTAL_CONFIGURATION_ID": "bpc_1U3InjGHuCWtbWKO5bH7t1qe"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nib",
      "database_id": "98cba748-418c-4428-a981-2192f62f9760",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "nib-artifacts",
      "preview_bucket_name": "nib-artifacts-preview"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "ACCEPTANCE_EVENTS", "queue": "nib-acceptance-events" },
      { "binding": "METERING_QUEUE", "queue": "nib-metering" }
    ],
    "consumers": [
      {
        "queue": "nib-acceptance-events",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "dead_letter_queue": "nib-acceptance-events-dlq"
      },
      {
        "queue": "nib-metering",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "nib-metering-dlq"
      }
    ]
  },
  "workflows": [
    {
      "name": "nib-generation",
      "binding": "GENERATE_WORKFLOW",
      "class_name": "GenerationWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ACCEPTANCE", "class_name": "AcceptanceCoordinator" },
      { "name": "TENANT_GATE", "class_name": "TenantGate" },
      { "name": "SCHEDULER", "class_name": "GenerationScheduler" },
      { "name": "TRIAL_GATE", "class_name": "TrialGate" }
    ]
  },
  // Durable Object migration history is replayed in order, so the class names
  // below are a historical record and must not be rebranded. VisualizeContainer
  // and TopcoatContainer are inert: they are created by v1 and deleted again by
  // v3-workers-only. The live classes (TenantGate, GenerationScheduler,
  // TrialGate) never carried the old brand, so no rename migration is needed.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VisualizeContainer", "TopcoatContainer", "TenantGate", "GenerationScheduler"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TrialGate"]
    },
    {
      "tag": "v3-workers-only",
      "deleted_classes": ["VisualizeContainer", "TopcoatContainer"]
    },
    { "tag": "v4-acceptance", "new_sqlite_classes": ["AcceptanceCoordinator"] }
  ]
}
