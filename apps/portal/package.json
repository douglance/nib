{
  "name": "@douglance/nib-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --import tsx --test src/server/index.test.ts src/server/devices.test.ts src/server/requests.test.ts src/server/retention.test.ts src/server/notifications.test.ts src/server/waiting/detect.test.ts src/server/waiting/watcher.test.ts",
    "test:web": "node --test src/client/sw.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm test && npm run build",
    "server": "tsx src/server/index.ts",
    "preview": "npm run build && NODE_ENV=production tsx src/server/index.ts",
    "mobile:build": "npm run mobile:build:ios && npm run mobile:build:watch",
    "mobile:build:ios": "xcodebuild -project mobile/Nib/Nib.xcodeproj -scheme Nib -destination 'generic/platform=iOS Simulator' build",
    "mobile:build:watch": "xcodebuild -project mobile/Nib/Nib.xcodeproj -scheme NibWatch -destination 'generic/platform=watchOS Simulator' build",
    "serve:tailscale": "tailscale serve --bg http://127.0.0.1:4070",
    "apns:configure": "bash scripts/configure-apns-env.sh",
    "launchd:install": "bash scripts/install-launchd.sh",
    "launchd:uninstall": "launchctl bootout gui/$UID ~/Library/LaunchAgents/com.douglance.nib.plist 2>/dev/null || true; rm -f ~/Library/LaunchAgents/com.douglance.nib.plist"
  },
  "dependencies": {
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^0.542.0",
    "playwright": "^1.59.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2"
  }
}
