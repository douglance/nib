{
  "contract": "nib.cloudflare-preview/v1",
  "projectId": "00000000-0000-4000-8000-000000000101",
  "subject": "onboarding-review-delivery",
  "gate": "pilot-onboarding",
  "title": "Onboarding review delivery",
  "request": "Confirm that a new customer can receive and open a Nib review request from the Cloudflare preview.",
  "change": "Deploys the authenticated public Worker with private site and review service dependencies into an isolated acceptance preview stack.",
  "revision": "replace-with-ci-commit-sha",
  "build": {
    "commit": "replace-with-ci-commit-sha",
    "repository": {
      "id": "nib",
      "owner": "douglance",
      "name": "nib"
    }
  },
  "criteria": [
    {
      "id": "onboarding-email",
      "text": "The preview creates a customer review request without production notification bindings.",
      "verification": "Run the onboarding smoke against the preview URL and attach the JSON result."
    },
    {
      "id": "review-open",
      "text": "The review page opens from the preview URL and shows the seeded request.",
      "verification": "Attach browser evidence captured from the preview URL."
    }
  ],
  "references": {
    "pilotEmails": {
      "onboarding": { "env": "NIB_ACCEPTANCE_PILOT_ONBOARDING_EMAIL" }
    },
    "previewSecrets": [
      { "name": "AUTH_RATE_LIMIT_SECRET", "env": "NIB_ACCEPTANCE_PREVIEW_AUTH_RATE_LIMIT_SECRET" },
      { "name": "ACCEPTANCE_SIGNING_JWK", "env": "NIB_ACCEPTANCE_PREVIEW_ACCEPTANCE_SIGNING_JWK" }
    ]
  },
  "cloudflare": {
    "wranglerPackage": "apps/web",
    "components": [
      {
        "name": "nib-site",
        "config": "apps/web/site/wrangler.jsonc",
        "cwd": "apps/web/site"
      },
      {
        "name": "nib-global",
        "config": "apps/cloudflare/wrangler.jsonc",
        "cwd": "apps/cloudflare"
      },
      {
        "name": "nib",
        "primary": true,
        "preview": "isolated-stack",
        "config": "apps/web/wrangler.jsonc",
        "cwd": "apps/web",
        "seed": {
          "d1": [
            {
              "binding": "DB",
              "file": "examples/acceptance/onboarding/seed.sql"
            }
          ],
          "r2": [
            {
              "binding": "ARTIFACTS",
              "key": "acceptance/onboarding/request.json",
              "file": "examples/acceptance/onboarding/review-request.json"
            }
          ]
        },
        "vars": {
          "ACCEPTANCE_ENABLED": "true"
        }
      }
    ]
  },
  "evidence": []
}
