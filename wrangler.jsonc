{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "visualize",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "observability": { "enabled": true },
  "assets": {
    "directory": "./site/dist/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  },
  "services": [
    { "binding": "SITE", "service": "visualize-topcoat" }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "ai": { "binding": "AI" },
  "vars": {
    "AI_GATEWAY_ID": "default",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_POLICY_AUD": "",
    "ENVIRONMENT": "production",
    "PUBLIC_ORIGIN": "https://visualize.doug-lance.workers.dev",
    "CLOUDFLARE_ACCOUNT_ID": "88f9cbf5c4f4e217079bcbf0ca6cb181",
    "TRIAL_NETWORK_IDENTITIES_30D": "3",
    "TRIAL_GLOBAL_DAILY_LIMIT": "50",
    "DEFAULT_PRICE_ID": "price_1U0444GHuCWtbWKOy5hXi8aH",
    "HIGH_PRICE_ID": "price_1U0444GHuCWtbWKOZknqhPjf",
    "USAGE_PRICE_ID": "price_1U044nGHuCWtbWKOAGw6Xy9Y"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "visualize",
      "database_id": "98cba748-418c-4428-a981-2192f62f9760",
      "migrations_dir": "worker/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "visualize-artifacts",
      "preview_bucket_name": "visualize-artifacts-preview"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "METERING_QUEUE", "queue": "visualize-metering" }
    ],
    "consumers": [
      {
        "queue": "visualize-metering",
        "max_batch_size": 25,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "visualize-metering-dlq"
      }
    ]
  },
  "workflows": [
    {
      "name": "visualize-generation",
      "binding": "GENERATE_WORKFLOW",
      "class_name": "GenerationWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "TENANT_GATE", "class_name": "TenantGate" },
      { "name": "SCHEDULER", "class_name": "GenerationScheduler" },
      { "name": "TRIAL_GATE", "class_name": "TrialGate" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VisualizeContainer", "TopcoatContainer", "TenantGate", "GenerationScheduler"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["TrialGate"]
    },
    {
      "tag": "v3-workers-only",
      "deleted_classes": ["VisualizeContainer", "TopcoatContainer"]
    }
  ]
}
