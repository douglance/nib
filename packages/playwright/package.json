{
  "name": "@nib/playwright",
  "version": "0.1.0",
  "description": "Playwright reporter for sending visual test artifacts to Nib Requests",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nib/protocol": "file:../protocol",
    "@nib/sdk": "file:../sdk"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
